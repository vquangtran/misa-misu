rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi gia đình là một nhánh families/<mã gia đình>/...
    // Ai có mã gia đình (23 ký tự ngẫu nhiên) thì đọc/ghi được nhánh đó.
    match /families/{family}/{col}/{id} {
      allow read, write: if request.auth != null
        && family.size() >= 20
        && col in ['kids', 'chores', 'rewards', 'done', 'ledger', 'paid', 'timetables', 'lessons', 'stays', 'events', 'tasks', 'goals'];
    }
  }
}
